<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>se.liot.trafikkamerarkivet.svep</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/python3</string>
        <string>@ROT@/src/collect.py</string>
    </array>
    <key>WorkingDirectory</key>
    <string>@ROT@</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/bin:/bin</string>
        <key>ARKIV_DIR</key>
        <string>@ARKIV@</string>
    </dict>
    <!-- Var 5:e minut. Kamerorna uppdateras ungefär en gång i minuten,
         så varje svep hämtar en färsk bild. -->
    <key>StartInterval</key>
    <integer>300</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>@ROT@/data/logg/svep.log</string>
    <key>StandardErrorPath</key>
    <string>@ROT@/data/logg/svep.log</string>
    <key>LowPriorityIO</key>
    <true/>
    <key>Nice</key>
    <integer>5</integer>
</dict>
</plist>
