<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>se.liot.trafikkamerarkivet.komprimering</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/python3</string>
        <string>@ROT@/src/compact.py</string>
    </array>
    <key>WorkingDirectory</key>
    <string>@ROT@</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/bin:/bin</string>
        <key>ARKIV_DIR</key>
        <string>@ARKIV@</string>
    </dict>
    <!-- Gårdagen packas ihop 03:17, när dygnet är färdigt och ingen
         använder maskinen. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key><integer>3</integer>
        <key>Minute</key><integer>17</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>@ROT@/data/logg/komprimering.log</string>
    <key>StandardErrorPath</key>
    <string>@ROT@/data/logg/komprimering.log</string>
    <key>LowPriorityIO</key>
    <true/>
    <key>Nice</key>
    <integer>10</integer>
</dict>
</plist>
